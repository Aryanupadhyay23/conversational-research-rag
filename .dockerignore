# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment files and credentials (DO NOT bake secrets into Docker images)
.env
.env.*
*.env
.env.rag
.streamlit/secrets.toml

# Virtual environments
venv/
.venv/
env/
myenv/
ENV/
build/
dist/
*.egg-info/

# Git & CI/CD
.git/
.gitignore
.github/

# IDE and Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing and code quality caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local databases and vector stores
chroma_db/
.chroma/
*.db
*.sqlite3

# Host deployment scripts & config (run on host, not in container)
deploy/
appspec.yml

# Logs, scratch files and docker build metadata
.logs/
*.log
scratch/
Dockerfile
.dockerignore
