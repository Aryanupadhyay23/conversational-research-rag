# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment files and credentials (never bake secrets into images)
.env
.env.*
*.env
.env.rag
.streamlit/secrets.toml

# Virtual environments and packaging
venv/
.venv/
env/
myenv/
ENV/
build/
dist/
*.egg-info/

# Git, CI/CD, and documentation
.git/
.gitignore
.github/
*.md
LICENSE

# IDE and editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Tests, scratch scripts, and code-quality caches
tests/
scripts/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Local databases and persistent data
data/
*.db
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Host deployment scripts and config (run on host, not in the container)
deploy/
appspec.yml

# Logs, archives, and Docker build metadata
.logs/
*.log
scratch/
*.zip
*.tar
*.tar.gz
Dockerfile
.dockerignore
